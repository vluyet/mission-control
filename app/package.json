{
  "name": "mission-control-app",
  "version": "0.3.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "node scripts/with-root-env.mjs next dev -H 0.0.0.0",
    "build": "node scripts/build-live.mjs",
    "start": "node scripts/serve-live.mjs",
    "rebuild:live": "node scripts/rebuild-live.mjs",
    "clean:local": "node scripts/clean-local-artifacts.mjs",
    "db:bootstrap": "node scripts/bootstrap-db.mjs",
    "lint": "next lint",
    "test:migrations": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma validate && node scripts/with-root-env.mjs ./node_modules/.bin/prisma migrate status",
    "test:smoke": "node scripts/with-root-env.mjs node --test tests/smoke-routes.test.mjs",
    "test:activity": "node scripts/with-root-env.mjs node --test tests/activity-events.test.mjs",
    "test:auth": "node scripts/with-root-env.mjs node --test tests/auth-access.test.mjs",
    "test:constructor": "node scripts/with-root-env.mjs node --test --test-concurrency=1 tests/constructor-link.test.mjs tests/constructor-dispatch.test.mjs tests/constructor-callback-dedupe.test.mjs && node --test tests/constructor-status-route.test.mjs",
    "test:i18n": "node scripts/with-root-env.mjs node --test tests/i18n-behavior.test.mjs",
    "test": "npm run test:smoke && npm run test:activity && npm run test:auth && npm run test:constructor && npm run test:i18n",
    "ci:check": "npm run test:migrations && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:generate": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma generate",
    "db:migrate": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma migrate dev",
    "db:deploy": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma migrate deploy",
    "db:studio": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma studio",
    "db:seed": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma db seed",
    "db:reset": "node scripts/with-root-env.mjs ./node_modules/.bin/prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "next": "^14.2.26",
    "overtype": "^2.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.26",
    "playwright": "^1.59.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
