{
  "name": "mission-control-app",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start -H 0.0.0.0",
    "db:bootstrap": "node scripts/bootstrap-db.mjs",
    "lint": "next lint",
    "test:migrations": "prisma validate && prisma migrate status",
    "test:smoke": "node --test tests/smoke-routes.test.mjs",
    "test:activity": "node --test tests/activity-events.test.mjs",
    "test:auth": "node --test tests/auth-access.test.mjs",
    "test:openclaw": "node --test tests/openclaw-sync.test.mjs",
    "test": "npm run test:smoke && npm run test:activity && npm run test:auth && npm run test:openclaw",
    "ci:check": "npm run test:migrations && npm run test && npm run build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "next": "^14.2.26",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.26",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
